# Optional hard block when Cloudflare sends CF-IPCountry (orange-cloud). Empty header = skip (browser geo script handles that case).
RewriteEngine On
RewriteCond %{HTTP:CF-IPCountry} !^$
RewriteCond %{HTTP:CF-IPCountry} !^(US|CA)$ [NC]
RewriteRule ^ - [F,L]
ErrorDocument 403 "We are sorry, but scheduling a call is not available outside the United States and Canada. If you feel you have received this message in error, please call us at 801-748-2281."
